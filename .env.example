# ─── Core ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO

# ─── Product analytics (server-side PostHog) ────────────────────────────────
# Project token is safe to use for event ingestion but remains server-side here.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_DISABLED=false

# ─── Marketing visitor intelligence (platform admins only) ─────────────────
# Comma-separated Churnary team emails that may access /api/visitors.
# Supabase users with app_metadata.role=admin or platform_admin are also allowed.
VISITOR_ADMIN_EMAILS=
# Configure RB2B's generic webhook as:
#   https://<api-host>/api/visitors/webhooks/rb2b?key=<this-value>
RB2B_WEBHOOK_SECRET=
# Optional, used only for pilot cost-per-match reporting.
RB2B_MONTHLY_COST_USD=0

# ─── Discord visitor companion ──────────────────────────────────────────────
# Create an app at discord.com/developers/applications. The bot token and
# channel webhook URL are secrets; never expose them as VITE_ variables.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ALERT_CHANNEL_ID=
# Optional least-privilege alternative for proactive alerts. Slash commands
# still require the application ID, public key, guild ID, and command setup.
DISCORD_WEBHOOK_URL=
# Members with Manage Server are allowed automatically. Add role IDs here to
# grant the private /churnary commands to other teammates.
DISCORD_ALLOWED_ROLE_IDS=
DISCORD_ALERT_MIN_INTENT_SCORE=25
# Keep professional email out of Discord unless the channel is tightly controlled.
DISCORD_INCLUDE_EMAIL=false

# Runtime URL may use the Supabase transaction pooler (port 6543). Alembic
# requires the direct database URL (port 5432) when migrations are deployed.
DATABASE_URL=postgresql+asyncpg://pulse:pulse@localhost:5432/pulse
DATABASE_MIGRATION_URL=
DB_USE_PGBOUNCER=false
DB_SSL=



# ─── Supabase Auth ───────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_JWT_SECRET=your_jwt_secret          # used to verify access tokens server-side

# ─── Secrets at rest ─────────────────────────────────────────────────────────
# 32-byte urlsafe-base64 key used to Fernet-encrypt OAuth tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ─── Token Router (ALL LLM / "AAM" model calls route through this gateway) ───
# Protocol: "openai" => POST {base}/chat/completions, "anthropic" => {base}/messages
TOKEN_ROUTER_API_KEY=
TOKEN_ROUTER_BASE_URL=          # e.g. https://api.tokenrouter.io/v1
TOKEN_ROUTER_MODEL=claude-sonnet-4-6
TOKEN_ROUTER_PROTOCOL=openai



# ─── Competitor price research ───────────────────────────────────────────────
# Server-only. Used by POST /api/competitor-prices/research.
# Pipeline v2 keeps place discovery, source search, content retrieval, and
# bounded extraction as independent provider stages.
PRICING_PIPELINE_V2_ENABLED=true
PRICING_MONITORING_ENABLED=false
PRICING_DAILY_FRESH_RUN_LIMIT=10
PRICING_COMPLETE_CACHE_MINUTES=120
PRICING_NO_EVIDENCE_CACHE_MINUTES=30
PRICING_MAX_PROVIDER_COST_USD=0.10
PRICING_MAX_COMPETITORS_PER_RUN=4
PRICING_MAX_AI_FALLBACKS_PER_RUN=2
PRICING_MAX_CONTENT_FALLBACKS_PER_RUN=1
PRICING_MAX_GEOCODING_REQUESTS_PER_RUN=1
PRICING_PLACE_PROVIDER=google_places
PRICING_SEARCH_PROVIDER=perplexity
PRICING_CONTENT_FALLBACK=none
PRICING_EXTRACTION_PROVIDER=sonar
PRICING_GOOGLE_PLACE_DETAILS_ENABLED=false
GOOGLE_MAPS_SERVER_API_KEY=
# Legacy fallback for existing deployments:
GOOGLE_MAPS_API_KEY=
ENABLE_GOOGLE_PLACES_DISCOVERY=true
ENABLE_DIRECT_SOURCE_FETCH=true
THIRD_PARTY_FRESHNESS_MONTHS=18
COMPETITOR_RESEARCH_DEADLINE_SECONDS=60
STRICT_FREE_TIER=false

FOURSQUARE_API_KEY=
FOURSQUARE_BASE_URL=https://places-api.foursquare.com
FOURSQUARE_API_VERSION=2025-06-17

PERPLEXITY_API_KEY=
PERPLEXITY_SEARCH_BASE_URL=https://api.perplexity.ai
ENABLE_PERPLEXITY_SEARCH=true
PERPLEXITY_SEARCH_COUNTRY=US
PERPLEXITY_SEARCH_CONTEXT_SIZE=high
PERPLEXITY_MAX_RESULTS=5
PERPLEXITY_MAX_QUERIES_PER_COMPETITOR=3
PERPLEXITY_MAX_TOKENS_PER_PAGE=2048

TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2

# TokenMart gateway. The API key remains server-side.
TOKENMART_API_KEY=
TOKENMART_BASE_URL=https://model.service-inference.ai/v1
TOKENMART_MODEL=deepseek-v4-flash
ENABLE_DEEPSEEK_EXTRACTION=true

# ─── RAG (business knowledge retrieval for campaign generation) ─────────────
# Embeddings via AWS Bedrock (Cohere Embed v4). Uses ambient AWS credentials
# (instance role in prod, `aws configure` / env vars locally) — no API key here.
# EMBEDDING_DIMENSIONS must match the model's output size; it's baked into the
# pgvector column at migration time, so changing models needs a new migration.
BEDROCK_REGION=us-east-1
BEDROCK_EMBEDDING_MODEL=cohere.embed-v4:0
EMBEDDING_DIMENSIONS=1536

# ─── Supabase (Postgres database + Auth) ─────────────────────────────────────
# The backend verifies Supabase access tokens. SUPABASE_URL alone suffices (JWKS);
# set SUPABASE_JWT_SECRET only for legacy HS256 projects.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Extra CORS origins (comma-separated) — add your Vercel domain in production.
EXTRA_CORS_ORIGINS=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@yourdomain.com
# Signs inbound POST /api/automations/resend/webhook (opens/clicks/bounces) —
# the "whsec_..." value Resend shows when you create the webhook endpoint
# (dashboard > Webhooks > add endpoint > events: opened, clicked, bounced, complained).
RESEND_WEBHOOK_SECRET=

# ─── SMS (Twilio) ────────────────────────────────────────────────────────────
# Also used to verify inbound webhook signatures (X-Twilio-Signature) for
# /api/automations/twilio/inbound and /twilio/status — register both with
# Twilio (Messaging service > webhooks) once API_BASE_URL is a real domain.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Automations (rule engine: TCPA quiet hours + dispatch cadence) ─────────
# TCPA: no SMS before this local hour or at/after this one (business's own
# timezone — Business.timezone, default America/New_York).
SMS_QUIET_HOURS_START=9
SMS_QUIET_HOURS_END=20
# How often the Celery beat dispatcher re-evaluates rules, in seconds.
AUTOMATION_DISPATCH_INTERVAL_SECONDS=900

# ─── Social presence (brand kit, campaigns, review queue, engagement inbox) ──
# Ported from the Splay codebase. Hexclave (HEXCLAVE_*, SPLAY_API_TOKEN) and
# Convex (CONVEX_*) are deliberately NOT carried over: auth is Supabase, and
# post media goes to S3/CloudFront instead of Convex blob storage.

# Buffer is the publishing rail for LinkedIn/X. One long-lived bearer token plus
# opaque channel ids — there is no OAuth flow. Publishing is refused outright
# unless the key and at least one channel id are set.
#   publish.buffer.com → Settings → Access token; channel ids from the URL.
BUFFER_API_KEY=
BUFFER_API_URL=https://api.buffer.com
BUFFER_LINKEDIN_PROFILE_IDS=        # comma-separated channel ids
BUFFER_X_PROFILE_IDS=               # comma-separated channel ids
BUFFER_PROFILE_IDS=                 # used when the per-platform list above is empty
# "now" publishes immediately; "queue" drops into the channel's posting schedule.
# A post that carries its own scheduled_for is always sent as customScheduled.
BUFFER_PUBLISH_MODE=now

# Seed values for a business's first brand kit, before they save their own.
BRAND_NAME=
BRAND_AUDIENCE=
BRAND_TONE=clear, specific, local

# Post imagery via TokenMart. The media endpoints live at the gateway *origin*,
# while TOKENMART_BASE_URL above carries the /v1 suffix used for chat calls.
TOKENMART_MEDIA_BASE_URL=https://model.service-inference.ai
TOKENMART_IMAGE_MODEL=dola-seedream-5-0-pro-260628
TOKENMART_IMAGE_SIZE=1280x720
TOKENMART_VIDEO_MODEL=dreamina-seedance-2-0-260128
TOKENMART_REQUEST_TIMEOUT_MS=300000
TOKENMART_MAX_RETRIES=2

# Public host for post media. Buffer fetches the image at publish time —
# possibly weeks after scheduling — so the URL must outlive the schedule.
# Use a public-read bucket behind CloudFront, not a short-lived presigned URL.
S3_MEDIA_BUCKET=
S3_MEDIA_PREFIX=social/
MEDIA_PUBLIC_BASE_URL=              # e.g. https://media.churnary.ai

# ─── Square OAuth ("Connect with Square" button) ─────────────────────────────
# developer.squareup.com → your app → OAuth. Register the redirect URL:
#   {API_BASE_URL}/api/integrations/oauth/square/callback
SQUARE_APP_ID=
SQUARE_APP_SECRET=
SQUARE_ENVIRONMENT=sandbox          # sandbox | production

# ─── Stripe (Connect OAuth button + Pulse billing) ───────────────────────────
# dashboard.stripe.com → Settings → Connect → OAuth. Client ID = ca_… Register:
#   {API_BASE_URL}/api/integrations/oauth/stripe/callback
STRIPE_CONNECT_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_GROWTH=price_xxx
STRIPE_PRICE_PRO=price_xxx

# Public URL of this backend — used to build the OAuth redirect URLs above.
API_BASE_URL=http://localhost:8000

# ─── Frontend ────────────────────────────────────────────────────────────────
# Consumed by Vite at build time (must be prefixed with VITE_). These are PUBLIC —
# never put service-role keys or other secrets here (they ship in the JS bundle).
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=              # https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=        # Supabase anon/public key
# Public RB2B account key copied from app.rb2b.com/script. Leave blank until
# the domain, privacy notice, consent controls, and webhook are all configured.
VITE_RB2B_KEY=
# Optional exact script URL/template from the RB2B dashboard. Use `{key}` where
# the public account key belongs. The documented S3 URL is used when blank.
VITE_RB2B_SCRIPT_URL=
